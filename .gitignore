__pycache__/
*.pyc
.idea/

uploads/*
!uploads/.gitkeep

reports/
reports_out/*
!reports_out/.gitkeep

sessions/*
!sessions/.gitkeep

archive/*
!archive/.gitkeep

.env
*.venv/
venv/

# PyInstaller build output for the desktop .exe (see build_exe.bat)
build/
dist/
*.spec

# Generated by build_exe.bat right before packaging (baked into the .exe so
# the version footer works even though the .exe has no .git bundled inside).
VERSION
